<Window x:Class="WindowsRepairToolkit.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:behaviors="clr-namespace:WindowsRepairToolkit.Behaviors"
        Title="Windows Repair Toolkit"
        Height="840" Width="1210"
        MinHeight="680" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Icon="Assets/logo.png">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid Background="{StaticResource BrandPaleBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Custom branded title bar. -->
        <Border Grid.Row="0"
                Background="{StaticResource BrandDeepBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Image Source="Assets/logo.png" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0"/>
                        <TextBlock Text="Windows Repair Toolkit" Foreground="White" FontSize="12.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="&#xE921;" ToolTip="Minimize" Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeWindow_Click"/>
                    <Button x:Name="MaximizeButton" Content="&#xE922;" ToolTip="Maximize" Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeRestoreWindow_Click"/>
                    <Button Content="&#xE8BB;" ToolTip="Close" Style="{StaticResource CloseTitleBarButtonStyle}" Click="CloseWindow_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Branded application header -->
            <Border Grid.Row="0"
                    Background="{StaticResource HeaderBrush}"
                    BorderBrush="{StaticResource BrandDeepBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14"
                    Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="74" Height="74" CornerRadius="10" Background="White" Padding="2" Margin="0,0,14,0">
                        <Image Source="Assets/logo.png" Stretch="Uniform"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="Windows Repair Toolkit"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="White"/>
                        <TextBlock Text="System health, repair, cleanup, and performance maintenance"
                                   FontSize="13"
                                   Foreground="#E8F1F7"
                                   Margin="0,2,0,7"/>
                        <Border Background="#263C678A" CornerRadius="5" Padding="8,5" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding SystemSummary}"
                                       ToolTip="{Binding SystemSummary}"
                                       Foreground="#F0F6FA"
                                       FontSize="11.5"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Recommended Repair"
                                Style="{StaticResource HeaderPrimaryButtonStyle}"
                                Command="{Binding SystemRepair.RecommendedRepairCommand}"/>
                        <Button Content="Create Restore Point"
                                Style="{StaticResource HeaderSecondaryButtonStyle}"
                                Command="{Binding SystemRepair.CreateRestorePointCommand}"/>
                        <Button Content="Cancel Current Task"
                                Style="{StaticResource CancelButtonStyle}"
                                Command="{Binding Operation.CancelCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Grid.Row="1" Focusable="False">
                <TabItem Header="System Repair">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Margin="18">
                            <TextBlock Text="Windows image and protected-file repair" Style="{StaticResource SectionTitleTextStyle}"/>
                            <TextBlock Text="Use the recommended repair sequence for corruption, or run individual diagnostics and repairs."
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="0,4,0,16"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Repair Windows image" Style="{StaticResource CardTitleTextStyle}"/>
                                        <TextBlock Text="DISM RestoreHealth scans the component store and repairs corruption. Windows Update may be used as a repair source."
                                                   Style="{StaticResource BodyTextStyle}"
                                                   Margin="0,6,0,10"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Border Style="{StaticResource BadgeStyle}"><TextBlock Text="Safe" Style="{StaticResource BadgeTextStyle}"/></Border>
                                            <Border Style="{StaticResource BadgeStyle}"><TextBlock Text="Administrator" Style="{StaticResource BadgeTextStyle}"/></Border>
                                        </StackPanel>
                                        <Button Content="Run DISM RestoreHealth"
                                                Foreground="White"
                                                Style="{StaticResource PrimaryLargeButtonStyle}"
                                                HorizontalAlignment="Left"
                                                Command="{Binding SystemRepair.DismRestoreCommand}"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                                    <StackPanel>
                                        <TextBlock Text="System File Checker" Style="{StaticResource CardTitleTextStyle}"/>
                                        <TextBlock Text="SFC /scannow verifies protected Windows system files and replaces corrupted copies when possible."
                                                   Style="{StaticResource BodyTextStyle}"
                                                   Margin="0,6,0,10"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Border Style="{StaticResource BadgeStyle}"><TextBlock Text="Safe" Style="{StaticResource BadgeTextStyle}"/></Border>
                                            <Border Style="{StaticResource BadgeStyle}"><TextBlock Text="Administrator" Style="{StaticResource BadgeTextStyle}"/></Border>
                                        </StackPanel>
                                        <Button Content="Run SFC /scannow"
                                                Foreground="White"
                                                Style="{StaticResource PrimaryLargeButtonStyle}"
                                                HorizontalAlignment="Left"
                                                Command="{Binding SystemRepair.SfcCommand}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource CardBorderStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="DISM diagnostics" Style="{StaticResource CardTitleTextStyle}"/>
                                        <TextBlock Text="CheckHealth is a quick corruption-state check. ScanHealth performs a deeper component-store scan without making repairs."
                                                   Style="{StaticResource BodyTextStyle}"
                                                   Margin="0,5,18,0"/>
                                    </StackPanel>
                                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                        <Button Content="CheckHealth" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SystemRepair.DismCheckCommand}"/>
                                        <Button Content="ScanHealth" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding SystemRepair.DismScanCommand}"/>
                                    </WrapPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Cleanup &amp; Storage">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Margin="16">
                            <TextBlock Text="Cleanup and storage maintenance" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,12"/>
                            <GroupBox Header="Cleanup">
                                <StackPanel>
                                    <TextBlock Text="Temporary-file cleanup skips locked or in-use files. Component cleanup intentionally does not use ResetBase."
                                               Style="{StaticResource MutedTextStyle}"
                                               Margin="0,0,0,8"/>
                                    <WrapPanel>
                                        <Button Content="Clean Temp Files" Command="{Binding CleanupStorage.TempCleanupCommand}"/>
                                        <Button Content="Empty Recycle Bin" Command="{Binding CleanupStorage.RecycleBinCommand}"/>
                                        <Button Content="Component Cleanup" Command="{Binding CleanupStorage.ComponentCleanupCommand}"/>
                                        <Button Content="Disk Cleanup" Command="{Binding CleanupStorage.DiskCleanupCommand}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Drive Optimization">
                                <StackPanel>
                                    <TextBlock Text="Uses defrag /O on the Windows volume. Windows selects the appropriate optimization for the detected media type, including retrim where appropriate."
                                               Style="{StaticResource MutedTextStyle}"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="Optimize System Drive" Command="{Binding CleanupStorage.OptimizeDriveCommand}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Startup">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Startup items" Style="{StaticResource CardTitleTextStyle}"/>
                                    <TextBlock Text="Scans Run registry keys and Startup folders. Disabled entries are backed up before changes are made."
                                               Style="{StaticResource MutedTextStyle}" Margin="0,5,12,0"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Content="Scan Startup Items" Command="{Binding Startup.ScanCommand}"/>
                                    <Button Content="Disable Selected" Command="{Binding Startup.DisableSelectedCommand}"/>
                                    <Button Content="Restore Disabled" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding Startup.RestoreDisabledCommand}"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Startup.Items}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" SelectionMode="Extended" AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="120" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="*" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="260" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Debloat">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Conservative AppX cleanup" Style="{StaticResource CardTitleTextStyle}"/>
                                        <Border Style="{StaticResource AdvancedBadgeStyle}" Margin="10,0,0,0"><TextBlock Text="Advanced" Style="{StaticResource AdvancedBadgeTextStyle}"/></Border>
                                    </StackPanel>
                                    <TextBlock Text="Lists a curated set of removable consumer packages and removes only explicitly selected packages for the current user. Frameworks, Store infrastructure, provisioned packages, and other users are not modified."
                                               Style="{StaticResource MutedTextStyle}" Margin="0,5,12,0"/>
                                </StackPanel>
                                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                                    <Button Content="Scan Candidates" Command="{Binding Debloat.ScanCommand}"/>
                                    <Button Content="Remove Selected" Command="{Binding Debloat.RemoveSelectedCommand}"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Debloat.Items}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="False" AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Select" Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                                <DataGridTextColumn Header="Package" Binding="{Binding Name}" Width="260" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Why listed" Binding="{Binding Reason}" Width="180" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Package Full Name" Binding="{Binding PackageFullName}" Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Profile Bloat">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Profile size analysis" Style="{StaticResource CardTitleTextStyle}"/>
                                    <TextBlock Text="Read-only analysis of the largest first-level folders in the user profile, AppData Local, and AppData Roaming. No profile data is deleted."
                                               Style="{StaticResource MutedTextStyle}" Margin="0,5,12,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Analyze Profile" VerticalAlignment="Center" Command="{Binding Profile.AnalyzeCommand}"/>
                            </Grid>
                        </Border>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Profile.Items}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Area" Binding="{Binding Area}" Width="150"/>
                                <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="110"/>
                                <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </TabItem>

                <TabItem Header="Search &amp; Explorer">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Margin="16">
                            <TextBlock Text="Search and Explorer repair" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,12"/>
                            <GroupBox Header="Windows Search">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Style="{StaticResource AdvancedBadgeStyle}"><TextBlock Text="Advanced" Style="{StaticResource AdvancedBadgeTextStyle}"/></Border>
                                        <Border Style="{StaticResource BadgeStyle}"><TextBlock Text="Administrator" Style="{StaticResource BadgeTextStyle}"/></Border>
                                    </StackPanel>
                                    <TextBlock Text="Rebuild resets the SystemIndex catalog. Existing files are not deleted, but search results can be incomplete until indexing finishes."
                                               Style="{StaticResource MutedTextStyle}"/>
                                    <Button Content="Rebuild Search Index" HorizontalAlignment="Left" Margin="4,10,4,4" Command="{Binding SearchExplorer.RebuildIndexCommand}"/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox Header="Explorer Caches">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Style="{StaticResource AdvancedBadgeStyle}"><TextBlock Text="Advanced" Style="{StaticResource AdvancedBadgeTextStyle}"/></Border>
                                        <Border Style="{StaticResource BadgeStyle}"><TextBlock Text="Administrator" Style="{StaticResource BadgeTextStyle}"/></Border>
                                    </StackPanel>
                                    <TextBlock Text="Stops Explorer, clears icon and thumbnail cache databases, then starts Explorer again. Open File Explorer windows may close."
                                               Style="{StaticResource MutedTextStyle}"/>
                                    <Button Content="Rebuild Explorer Caches" HorizontalAlignment="Left" Margin="4,10,4,4" Command="{Binding SearchExplorer.RebuildExplorerCommand}"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Windows Update">
                    <StackPanel Margin="16">
                        <TextBlock Text="Windows Update maintenance" Style="{StaticResource SectionTitleTextStyle}" Margin="0,0,0,12"/>
                        <Border Style="{StaticResource CardBorderStyle}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Border Style="{StaticResource AdvancedBadgeStyle}"><TextBlock Text="Advanced" Style="{StaticResource AdvancedBadgeTextStyle}"/></Border>
                                    <Border Style="{StaticResource BadgeStyle}"><TextBlock Text="Restart may be required" Style="{StaticResource BadgeTextStyle}"/></Border>
                                </StackPanel>
                                <TextBlock Text="Searches, downloads, and installs applicable software updates through Windows Update Agent."
                                           Style="{StaticResource BodyTextStyle}"/>
                                <WrapPanel Margin="0,10,0,0">
                                    <Button Content="Install Available Updates" Command="{Binding WindowsUpdate.InstallUpdatesCommand}"/>
                                    <Button Content="Open Windows Update Settings" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding WindowsUpdate.OpenSettingsCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <!-- Compact status strip. Activity Log is collapsed until requested. -->
            <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,9,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="9" Height="9" Fill="{StaticResource BrandPrimaryBrush}" VerticalAlignment="Top" Margin="1,5,9,0"/>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Operation.StatusText}" FontWeight="SemiBold" Foreground="{StaticResource BrandDarkBrush}"/>
                        <ProgressBar Height="8" Minimum="0" Maximum="100"
                                     Value="{Binding Operation.ProgressValue, Mode=OneWay}"
                                     IsIndeterminate="{Binding Operation.IsProgressIndeterminate, Mode=OneWay}"
                                     Margin="0,6,12,0"/>
                    </StackPanel>
                    <Button Grid.Column="2"
                            Content="{Binding ToggleActivityLogText}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            MinWidth="140"
                            Command="{Binding ToggleActivityLogCommand}"/>
                </Grid>
            </Border>

            <Border Grid.Row="3"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="7"
                    Padding="10"
                    Margin="0,7,0,0"
                    Visibility="{Binding IsActivityLogVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="170"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="2,0,2,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Activity Log" FontWeight="SemiBold" Foreground="{StaticResource BrandDeepBrush}"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Operation.LogPath}"
                                   HorizontalAlignment="Right"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="650"/>
                    </Grid>
                    <TextBox Grid.Row="1"
                             Text="{Binding Operation.ActivityLogText, Mode=OneWay}"
                             behaviors:TextBoxAutoScrollBehavior.AutoScroll="True"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="12"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
